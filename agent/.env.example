# Environment variables only; this file is documentation and is not auto-loaded.
AI_SERVICE_TOKEN=
AI_ERP_BASE_URL=http://127.0.0.1:8081
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=
# Optional per-node model overrides, same configured OpenAI-compatible provider.
AI_PLANNER_MODEL=
AI_REFLECTION_MODEL=
# Hard caps: 1..8 tools per request, 1..3 planning/reflection attempts.
AI_MAX_TOOL_CALLS=4
AI_MAX_REFLECTIONS=2
# DeepSeek non-thinking mode defaults false; enables explicit provider request field.
AI_LLM_THINKING_ENABLED=false
